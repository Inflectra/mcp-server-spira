# Automatically activate Python virtual environment
# This file is used by direnv to set up the environment when entering this directory

# Activate the virtual environment
source .venv/bin/activate

# Optional: Set environment variables for development
# export SPIRA_BASE_URL="https://your-spira-instance.com"
# export SPIRA_USERNAME="your-username"
# export SPIRA_API_KEY="your-api-key"
